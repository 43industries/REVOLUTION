; Engine configuration file.
; Godot 4.x — REVOLUTION anime 3D remake (placeholders first; W+T 4D combat).

config_version=5

[application]

config/name="REVOLUTION"
config/description="No Electricity. No Mercy. Anime 3D remake with W-lane + time combat."
config/version="0.1.0"
run/main_scene="res://scenes/arena.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

CombatFX="*res://autoload/combat_fx.gd"
GameFlow="*res://autoload/game_flow.gd"
SaveGame="*res://autoload/save_game.gd"
StoryDB="*res://autoload/story_db.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

